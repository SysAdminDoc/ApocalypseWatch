{
  "name": "apocalypsewatch",
  "private": true,
  "version": "0.2.1",
  "description": "Business-jet activity dashboard with source timestamps, historical context and exportable evidence.",
  "type": "commonjs",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "preview": "npm run preview --workspace client",
    "start": "node server/index.js",
    "import:faa": "python3 scripts/import_faa_cohort.py",
    "seed:demo": "python3 scripts/seed_demo_data.py",
    "backfill": "python3 scripts/backfill_history.py",
    "update:daily": "python3 scripts/backfill_history.py --relative-days 1",
    "export:snapshot": "node scripts/export_dashboard_snapshot.js",
    "rss:update": "node scripts/update_rss_feed.js",
    "telegram:alert": "node scripts/send_telegram_alert.js",
    "update:api": "python3 scripts/update_latest_from_api.py",
    "lint": "npm run lint --workspace client",
    "test": "node --test server/dashboard.test.js client/src/lib/archive.test.js client/src/lib/evidence.test.js client/src/lib/signal.test.js scripts/release.test.js",
    "build:branding": "node scripts/generate_og_image.js",
    "build:local": "node scripts/build-client.js local",
    "build:demo": "node scripts/build-client.js demo",
    "package": "node scripts/package-release.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "concurrently": "^9.2.1",
    "fflate": "0.8.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
